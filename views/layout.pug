              a(href="/music") Music
            li
              a(href="/shows") Shows
            li
              a(href="/about") About
            li
              a(href="/contact") Contact

      block header

      main
        block main

      footer.site-footer
        div.container
          p fwb
          p
            a(href="mailto:hello@fwb.clintspacewood.com") hello@fwb.clintspacewood.com
          p.footer-parent
            | A Clint Spacewood band &mdash;
            |  
            a(href="https://clintspacewood.com" target="_blank") clintspacewood.com
