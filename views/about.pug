extends layout

block main
  section.section
    div.page-head
      h1 About

    div.about-card
      div.about-media
        if about.band.image
          img(src=about.band.image alt="Band photo")
        else
          div.media-placeholder(aria-hidden="true")
            span Band photo
      div.about-info
        h2= about.band.title
        p= about.band.text
        p Whether it is a quiet single or a backyard packed with people, we care about the details that make the whole thing feel like a good time.

