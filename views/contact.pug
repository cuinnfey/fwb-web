extends layout

block main
  section.section
    div.page-head
      h1 Contact
      p.page-intro= contact.intro

    div.contact-grid
      div.contact-card
        h2 Get in touch
        p Email us directly and we will get back to you.
        a.btn(href=`mailto:${contact.email}`)= contact.email
        div.contact-links
          each link in contact.socialLinks
            a(href=link.url target="_blank")= link.name
      div.contact-card
        h2 Send a note
        form(action=`mailto:${contact.email}` method="post" enctype="text/plain")
          label(for="name") Name
          input#name(type="text" name="name" placeholder="Your name" required)
          label(for="email") Email
          input#email(type="email" name="email" placeholder="you@example.com" required)
          label(for="message") Message
          textarea#message(name="message" rows="5" placeholder="Tell us about your show or project" required)
          button.btn(type="submit") Send
