extends layout

block header
  header.hero
    div.container
      div.hero-wordmark
        span.kicker= home.wordmark.kicker
        span.script= home.wordmark.title
      div.carousel
        each slide, index in home.carousel
          input(id=`slide-${index + 1}` class="carousel-input" type="radio" name="carousel" checked=(index === 0))
        div.carousel-track
          each slide in home.carousel
            div.carousel-slide
              img(src=slide.image alt=slide.alt)
        div.carousel-dots
          each slide, index in home.carousel
            label(for=`slide-${index + 1}` aria-label=`Show photo ${index + 1}`)

block main
  section.section
    div.section-head
      h2 Latest
      a.section-link(href="/music") All music
    div.card-grid
      each release in releases
        article.tile
          a(href=release.link target=(release.link === '#' ? '_self' : '_blank'))
            div.tile-media
              if release.image
                img(src=release.image alt=release.name)
              else
                div.media-placeholder(aria-hidden="true")
                  span Cover
            div.tile-body
              span.tile-tag= release.tag
              h3.tile-title= release.name
              p.tile-meta= release.year
              p.tile-blurb= release.blurb
