extends layout

block header
  header.hero
    div.container
      div.hero-wordmark
        span.kicker Now cruising
        span.script friends w/ benefits
      div.carousel
        input#slide-1.carousel-input(type="radio" name="carousel" checked)
        input#slide-2.carousel-input(type="radio" name="carousel")
        input#slide-3.carousel-input(type="radio" name="carousel")
        div.carousel-track
          div.carousel-slide
            div.media-placeholder(aria-hidden="true")
              span Photo 1
          div.carousel-slide
            div.media-placeholder(aria-hidden="true")
              span Photo 2
          div.carousel-slide
            div.media-placeholder(aria-hidden="true")
              span Photo 3
        div.carousel-dots
          label(for="slide-1" aria-label="Show photo 1")
          label(for="slide-2" aria-label="Show photo 2")
          label(for="slide-3" aria-label="Show photo 3")
      div.hero-intro
        p fwb is two friends, one red moped, and a whole lot of songs. Sunny, loud, and a little bit silly &mdash; pull up a lawn chair.

block main
  section.section
    div.section-head
      h2 Latest
      a.section-link(href="/music") All music
    div.card-grid
      each release in releases
        article.tile
          a(href=release.link target=(release.link === '#' ? '_self' : '_blank'))
            div.tile-media
              if release.image
                img(src=release.image alt=release.name)
              else
                div.media-placeholder(aria-hidden="true")
                  span Cover
            div.tile-body
              span.tile-tag= release.tag
              h3.tile-title= release.name
              p.tile-meta= release.year
              p.tile-blurb= release.blurb
